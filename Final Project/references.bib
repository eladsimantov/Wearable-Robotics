@article{batzianoulis_decoding_2018,
	title = {Decoding the grasping intention from electromyography during reaching motions},
	volume = {15},
	issn = {1743-0003},
	url = {https://doi.org/10.1186/s12984-018-0396-5},
	doi = {10.1186/s12984-018-0396-5},
	abstract = {Active upper-limb prostheses are used to restore important hand functionalities, such as grasping. In conventional approaches, a pattern recognition system is trained over a number of static grasping gestures. However, training a classifier in a static position results in lower classification accuracy when performing dynamic motions, such as reach-to-grasp. We propose an electromyography-based learning approach that decodes the grasping intention during the reaching motion, leading to a faster and more natural response of the prosthesis.},
	language = {en},
	number = {1},
	urldate = {2024-12-16},
	journal = {Journal of NeuroEngineering and Rehabilitation},
	author = {Batzianoulis, Iason and Krausz, Nili E. and Simon, Ann M. and Hargrove, Levi and Billard, Aude},
	month = jun,
