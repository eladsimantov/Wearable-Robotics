@misc{lento_data_2024,
	title = {Data and code for {3D}-{ARM}-{Gaze}: a public dataset of {3D} {Arm} {Reaching} {Movements} with {Gaze} information in virtual reality},
	shorttitle = {Data and code for {3D}-{ARM}-{Gaze}},
	url = {https://zenodo.org/records/11202159},
	doi = {10.5281/zenodo.11202159},
	abstract = {This repository contains data and code for

Lento B., Segas E., Leconte V., Doat E., Danion F., Péteri R., Benois-Pineau J., de Rugy A. (2024). 3D-ARM-Gaze: a public dataset of 3D Arm Reaching Movements with Gaze information in virtual reality. doi:

